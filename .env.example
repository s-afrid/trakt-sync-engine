# Deployment & App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SECRET="super-secret-encryption-key-for-session-and-tokens-32chars"

# Database (PostgreSQL / Neon serverless URL)
DATABASE_URL="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"

# Trakt.tv API Application
# Create at: https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID="your-trakt-client-id"
TRAKT_CLIENT_SECRET="your-trakt-client-secret"
TRAKT_REDIRECT_URI="http://localhost:3000/api/auth/trakt/callback"

# MyAnimeList API Application
# Create at: https://myanimelist.net/apiconfig (App type: Web, PKCE enabled)
MAL_CLIENT_ID="your-mal-client-id"
MAL_CLIENT_SECRET="your-mal-client-secret"
MAL_REDIRECT_URI="http://localhost:3000/api/auth/mal/callback"

# Vercel Cron Security Secret
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-random-cron-secret-token"

# Stremboxd credentials (for Trakt -> Letterboxd watched/watchlist sync)
# These can also use LETTERBOXD_USERNAME / LETTERBOXD_PASSWORD as a fallback.
STREMBOXD_USERNAME=""
STREMBOXD_PASSWORD=""

# Letterboxd credentials (also used by the Playwright browser auto-import)
LETTERBOXD_USERNAME=""
LETTERBOXD_PASSWORD=""
